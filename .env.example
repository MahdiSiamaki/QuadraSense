# Copy to .env and fill in. Never commit .env.
# Every variable the stack reads is listed here.

# ---- Operational store (PostgreSQL) --------------------------------------
# Jobs, TAC versions, audit, users. Port 15432 in development because another
# service on the machine already holds 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=sqm
POSTGRES_USER=sqm
POSTGRES_PASSWORD=change_me

# The connection string the API and worker actually read.
Postgres__ConnectionString=Host=localhost;Port=15432;Database=sqm;Username=sqm_app;Password=change_me

# Password for the application role created by db/operational/grants/003_least_privilege.sql.
# That role holds INSERT and SELECT on the audit tables and nothing else, so no application
# path - including a compromised one - can rewrite history. POSTGRES_USER above is the owner,
# used only by the migrator.
SQM_APP_DB_PASSWORD=change_me

# ---- Analytics store (ClickHouse) ----------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_DB=sqm
# Not 'default': the image restricts that account to loopback, and the application should not
# be running as the administrative user anyway. See infra/clickhouse/sqm-app-user.xml.
CLICKHOUSE_USER=sqm_app
CLICKHOUSE_PASSWORD=change_me

ClickHouse__ConnectionString=Host=localhost;Port=18123;Database=sqm;Username=sqm_app;Password=change_me
# Must stay below the HTTP client timeout, or a slow query is abandoned by the
# client while the server keeps working on it and the caller sees an opaque 500.
ClickHouse__QueryTimeoutSeconds=120

# ---- API -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
Api__CorsOrigins=http://localhost:5173

# Signing key for access tokens. Generate with:
#   openssl rand -base64 64
JWT_SIGNING_KEY=change_me_at_least_64_bytes_base64
JWT_ISSUER=sqm-platform
JWT_AUDIENCE=sqm-platform
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- Import platform -----------------------------------------------------
# Where uploaded originals are written. Outside the web root, never served
# directly. Originals are kept indefinitely (~144 GB/year): they are the
# ultimate backup, since every table is rebuildable from them plus the pipeline.
ImportStorage__RootPath=/var/sqm/uploads
# The same directory as ClickHouse sees it, when it can see it at all. Leave
# empty and the worker streams the file over HTTP instead.
ImportStorage__ServerPathPrefix=
ImportStorage__MaxFileBytes=10737418240

# One job at a time by default, and that is a measurement rather than caution:
# a daily import is bound by ClickHouse insert throughput, so two at once
# divide the same disk between them and finish later than running in sequence.
# Raise it on a production analytics server, against measurement.
ImportWorker__MaxConcurrentJobs=1
ImportWorker__PollInterval=00:00:05
# A worker that dies stops renewing; once the lease expires the job is
# claimable again. Shorter recovers faster; too short and a busy worker loses
# a job it is still working on.
ImportWorker__LeaseDuration=00:05:00
ImportWorker__LeaseRenewInterval=00:01:00
ImportWorker__RetryBaseDelay=00:00:30

# ---- Source directories (bulk loading and development) -------------------
SQM_SOURCE_DIR=D:/SQM
TAC_SOURCE_DIR=D:/TAC

# ---- Privacy -------------------------------------------------------------
# Masking is OFF by decision of the product owner (see docs/adr, Q4).
# Flip to true to mask MSISDN/IMSI/IMEI in API responses without a code change.
PRIVACY_MASK_IDENTIFIERS=false

# ---- Frontend ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
