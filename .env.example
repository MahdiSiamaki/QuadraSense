# Copy to .env and fill in. Never commit .env.
# Every variable the stack reads is listed here.

# ---- Operational store (PostgreSQL) --------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sqm
POSTGRES_USER=sqm_app
POSTGRES_PASSWORD=change_me

# Least-privilege role used only by the audit writer (INSERT, no UPDATE/DELETE)
POSTGRES_AUDIT_USER=sqm_audit
POSTGRES_AUDIT_PASSWORD=change_me

# ---- Analytics store (ClickHouse) ----------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=sqm
CLICKHOUSE_USER=sqm_app
CLICKHOUSE_PASSWORD=change_me

# ---- API -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173

# Signing key for access tokens. Generate with:
#   openssl rand -base64 64
JWT_SIGNING_KEY=change_me_at_least_64_bytes_base64
JWT_ISSUER=sqm-platform
JWT_AUDIENCE=sqm-platform
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- Ingestion -----------------------------------------------------------
# Directory the source system drops batch folders into (dump-NN.YYMMDDHHMMSS)
INGEST_WATCH_PATH=/srcdata/sqm
INGEST_TAC_PATH=/srcdata/tac
# Uploaded files are stored here, outside the web root, never directly served
INGEST_UPLOAD_PATH=/var/sqm/uploads
INGEST_MAX_UPLOAD_BYTES=10737418240
INGEST_MAX_CONCURRENT_JOBS=2

# ---- Privacy -------------------------------------------------------------
# Masking is OFF by decision of the product owner (see docs/adr, Q4).
# Flip to true to mask MSISDN/IMSI/IMEI in API responses without a code change.
PRIVACY_MASK_IDENTIFIERS=false

# ---- Frontend ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
