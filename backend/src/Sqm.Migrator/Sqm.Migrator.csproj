<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sqm.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Infrastructure, for the create-admin command only. The migrator is the tool that runs once
      against a fresh database, which is exactly when the first administrator has to exist; the
      alternatives were a seeded account with a known password, or an API endpoint that creates
      an administrator when none exists: a backdoor and an unauthenticated escalation path
      respectively.
    -->
    <ProjectReference Include="..\Sqm.Infrastructure\Sqm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" Version="7.14.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
