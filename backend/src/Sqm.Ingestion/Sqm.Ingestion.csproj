<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>dotnet-Sqm.Ingestion-c4743535-e52c-47e2-ac6b-baaa06d56bf8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sqm.Infrastructure\Sqm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sqm.Ingestion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The mart refresh is embedded rather than read from disk.

      It stays a .sql file in db/analytics/jobs so it is reviewable as SQL and runnable by hand,
      and it is compiled into the worker so deployment does not depend on a file being copied to
      a path the worker happens to look in. One copy, two ways to run it.
    -->
    <EmbeddedResource Include="../../../db/analytics/jobs/refresh_marts.sql"
                      LogicalName="Sqm.Ingestion.refresh_marts.sql" />
  </ItemGroup>

</Project>
