# QuadraSense deployment settings, read by compose.yaml in this directory.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit .env. Every password below is generated, never typed:
#
#   openssl rand -hex 24
#
# Hex, because the passwords are embedded in connection strings, where ';' and '=' are syntax.

# ---- Images -----------------------------------------------------------------------------------
# Where the four application images come from, and which build. The tag is the git commit the
# images were built from (docs/operations/deployment/01-container-images.md); never 'latest'.
#   department VM: images loaded with `docker load`, so the bare name
#   MCI Nexus:     <registry>:<port>/<project>
SQM_REGISTRY=quadrasense
SQM_TAG=

# Overrides for the third-party images, when they come from a mirror rather than Docker Hub.
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.33.6
# POSTGRES_IMAGE=postgres:17.11-bookworm

# ---- Where builds get what they need ----------------------------------------------------------
# Empty: the public sources (each Dockerfile's default). On the department's servers, the
# department's Nexus - its only permitted source (docs/operations/deployment/05-department-ci-cd.md).
# NuGet and npm read anonymously from it; Docker images need `docker login` to its pull endpoint first.
#   SQM_NUGET_SOURCE=https://<nexus>/repository/nuget-group/index.json
#   SQM_NPM_REGISTRY=https://<nexus>/repository/npm-public/
#   SQM_NODE_IMAGE=<nexus-pull>/library/node:24.19.0-alpine
#   SQM_NGINX_IMAGE=<nexus-pull>/nginxinc/nginx-unprivileged:1.28-alpine
#   SQM_SDK_IMAGE / SQM_RUNTIME_IMAGE - Microsoft's .NET images; Nexus has no proxy for their
#     registry yet, so these stay at the defaults until it does.
SQM_NUGET_SOURCE=
SQM_NPM_REGISTRY=
SQM_NODE_IMAGE=
SQM_NGINX_IMAGE=
SQM_SDK_IMAGE=
SQM_RUNTIME_IMAGE=

# Any UID. Every container runs as it, in group 0 - as OpenShift will run them.
SQM_RUN_UID=1000700000

# ---- PostgreSQL --------------------------------------------------------------------------------
# The owner (superuser of this cluster): migrations and grants only.
SQM_PG_OWNER_PASSWORD=
# sqm_app, the role the API and the worker connect as. Created by the grants job; INSERT and
# SELECT only on the audit tables (db/operational/grants/003_least_privilege.sql).
SQM_PG_APP_PASSWORD=

# ---- ClickHouse --------------------------------------------------------------------------------
# One per user in clickhouse/users.xml.
SQM_CH_MIGRATOR_PASSWORD=
SQM_CH_INGEST_PASSWORD=
SQM_CH_APP_PASSWORD=

# ---- The front door ----------------------------------------------------------------------------
# The address people type, scheme included. Must be HTTPS: the session cookie is Secure.
SQM_PUBLIC_ORIGIN=https://quadrasense.example.internal
SQM_HTTP_PORT=80
SQM_HTTPS_PORT=443
# Directory holding tls.crt (with any intermediate certificates after it) and tls.key.
SQM_TLS_DIR=./tls

# ---- Resources (department VM: 8 vCPU, 15 GiB) -------------------------------------------------
# 8 + 1 + 1.5 + 2 + 0.25 = 12.75 GiB, leaving ~2 GiB for the host and Docker.
CLICKHOUSE_MEMORY=8g
CLICKHOUSE_CPUS=6
POSTGRES_MEMORY=1g
POSTGRES_CPUS=2
API_MEMORY=1536m
API_CPUS=2
WORKER_MEMORY=2g
WORKER_CPUS=2
# max_memory_usage of each import, fold and dashboard-refresh statement, in bytes. Empty = the
# laptop's 1.2 GB, a limit of its 6 GiB container. The VM can afford more: 2.5 GB, inside the 6.4 GiB
# ClickHouse allows itself of CLICKHOUSE_MEMORY (statements run one at a time, on one thread). The
# statements that first outgrew 1.2 GB here were rewritten since (refresh_marts.sql section 1c).
SQM_CH_BOUNDED_MEMORY_BYTES=2500000000
