# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf
*.md      text
*.json    text
*.yml     text
*.yaml    text
*.sql     text
*.ts      text
*.vue     text
*.py      text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
