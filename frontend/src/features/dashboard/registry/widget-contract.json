{
  "$comment": "The dashboard widget allow-list, read by the frontend registry and embedded in the API's validator (ADR-016 section 3). Every type, every config field and its bounds. Adding a widget is three edits: this file, the registry entry, the component - the tests on both sides name the one that is missing.",
  "contractVersion": 1,
  "limits": {
    "titleMaxLength": 120,
    "subtitleMaxLength": 200,
    "gridColumns": 12,
    "maxRows": 400,
    "maxWidgetHeight": 40
  },
  "lens": {
    "countBy": ["bindings", "subscribers", "handsets"],
    "ranges": ["all", "last7", "last30", "last90", "last180", "last365"],
    "rangePattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\.\\d{4}-\\d{2}-\\d{2}$",
    "textFilterMaxLength": 120,
    "tacPattern": "^\\d{8}$",
    "refreshMinutes": [0, 5, 15, 30]
  },
  "groups": [
    { "id": "overview", "name": "Overview & Population" },
    { "id": "devices", "name": "Device Intelligence" },
    { "id": "change", "name": "Change & Movement" },
    { "id": "risk", "name": "Risk & Investigation" },
    { "id": "quality", "name": "Data Quality" },
    { "id": "operations", "name": "Data Operations" },
    { "id": "tools", "name": "Analyst Tools" }
  ],
