# ---- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pfx
*.key
appsettings.*.Local.json
secrets.json

# ---- data ----------------------------------------------------------------
# Never commit dataset files. The dumps are gigabytes and contain real PII.
*.csv
*.parquet
*.tsv
!tests/**/fixtures/*.csv
data/
_discovery/

# ---- .NET ----------------------------------------------------------------
bin/
obj/
*.user
*.suo
.vs/
TestResults/
coverage/
*.trx

# ---- node / frontend -----------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
.eslintcache

# ---- generated -----------------------------------------------------------
frontend/src/api/generated/
backend/**/openapi.json

# ---- python --------------------------------------------------------------
# Bytecode of tools/ and db/operational/jobs/. Two .pyc files were committed by
# accident; they are build output of files that are themselves committed.
__pycache__/
*.pyc

# ---- os / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/

# ---- deployment ----------------------------------------------------------
# The certificate and key a deployment mounts into the web container (deploy/compose/compose.yaml).
# The key is a credential; the directory sits inside a checkout that update.sh pulls into.
deploy/compose/tls/

# ---- local, never published ----------------------------------------------------
# The department's real hostnames, addresses and runner layout (docs/operations/deployment/05-...
# uses placeholders for them). This repository is public; this directory is not.
.private/
